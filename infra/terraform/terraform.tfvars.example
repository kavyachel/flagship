# AWS Configuration
aws_region  = "us-east-1"
environment = "staging"
app_name    = "flagship"

# VPC
vpc_cidr = "10.0.0.0/16"

# ECS
ecs_task_cpu      = 256
ecs_task_memory   = 512
ecs_desired_count = 2
container_port    = 3000

# RDS
db_instance_class = "db.t3.micro"
db_name           = "flagship"
db_username       = "flagship"
db_password       = "CHANGE_ME_TO_SECURE_PASSWORD"

# Redis
redis_node_type       = "cache.t3.micro"
redis_num_cache_nodes = 1
